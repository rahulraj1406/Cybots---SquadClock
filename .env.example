# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: push notifications (all four, or leave all empty) ---------
# Generate the key pair once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Project Settings -> API -> service_role. Server-only: never prefix it
# with NEXT_PUBLIC_, and never share it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: protect the daily keep-alive cron ---------------------------
# Any random string; Vercel sends it to /api/cron/keepalive automatically.
CRON_SECRET=
